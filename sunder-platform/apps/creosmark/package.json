{
  "name": "@sunderttrpg/creosmark",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "dotenv -e .env -- astro dev --port 5174",
    "build": "astro build",
    "preview": "astro preview --port 4174",
    "astro": "astro",
    "check": "node scripts/ensure-checker.mjs && node --test scripts/editor-sections.test.mjs scripts/editor-navigation.test.mjs && astro check",
    "test:editor-sections": "node --test scripts/editor-sections.test.mjs",
    "supabase:push": "dotenv -e .env -- supabase db push",
    "supabase:pull": "dotenv -e .env -- supabase db pull",
    "test:editor-navigation": "node --test scripts/editor-navigation.test.mjs"
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.1.4",
    "@astrojs/react": "^6.0.2",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@sunderttrpg/core": "workspace:*",
    "@sunderttrpg/experience-market": "workspace:*",
    "@sunderttrpg/schema": "workspace:*",
    "@supabase/supabase-js": "^2.99.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@xyflow/react": "^12.10.1",
    "astro": "^7.2.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "use-sync-external-store": "1.6.0",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "dotenv-cli": "^11.0.0",
    "supabase": "^2.78.1",
    "typescript": "6.0.2"
  }
}
