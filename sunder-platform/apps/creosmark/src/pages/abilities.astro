---
import '../styles/sunder-theme.css';
import AbilityBuilderPageEntry from "../components/abilities/AbilityBuilderPageEntry.tsx";
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Creosmark · Ability Builder</title>

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="alternate icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <script is:inline>
        window.addEventListener("vite:preloadError", (event) => {
            event.preventDefault();
            window.location.reload();
        });
    </script>
</head>
<body>
<AbilityBuilderPageEntry client:load />
</body>
</html>
