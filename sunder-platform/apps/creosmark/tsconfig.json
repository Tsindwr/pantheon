{
  "extends": "../../tsconfig.astro.json",
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM"],
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "types": []
  },
  "include": [
    "src",
    ".astro/types.d.ts",
    "**/*",
    "**/*.ts",
    "**/*.tsx"
  ]
}
