{
  "name": "@sunderttrpg/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./potentials": {
      "types": "./dist/potentials.d.ts",
      "import": "./dist/potentials.js"
    },
    "./skills": {
      "types": "./dist/skills.d.ts",
      "import": "./dist/skills.js"
    },
    "./conditions": {
      "types": "./dist/conditions.d.ts",
      "import": "./dist/conditions.js"
    },
    "./domains": {
      "types": "./dist/domains.d.ts",
      "import": "./dist/domains.js"
    },
    "./rules": {
      "types": "./dist/rules/index.d.ts",
      "import": "./dist/rules/index.js"
    },
    "./rolling": {
      "types": "./dist/rolling/index.d.ts",
      "import": "./dist/rolling/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "latest"
  }
}
